@page
@model CB.Pages.Items.IndexModel
@using System.Text
@{
    Layout = "_Layout";
}
<div id="PartsViewPort" class="text-center">
   @* <input type="hidden" id="hidCartContentsQty" name="hidCartContents.Qty" value="@Model.CartedItems.Count.ToString()" /> *@

    @{
        if(!HttpContext.Request.Host.ToString().Contains("localhost"))
            if(!HttpContext.Request.IsHttps)
                HttpContext.Response.Redirect("https://www.cornerbargins.net/items");
        // if(Model.IsValidUser)
        // {
        // <h2 class="">Welcome, @Model.UserName</h2>a


        if(Model.Items != null || Model.Items.Count > 0)
        {
            int cardCount = 0;
            int itemCount = 0;

            StringBuilder sb = new StringBuilder();
            sb.Append("<div class='row' style='border:solid 0px green;'>");
            string src = string.Empty;
            string hasImage = "none";
            string colorCode = "#77b300";
            string imageFull = string.Empty;
            foreach(Core.Item i in Model.Items)
            {
                if (i.Image != null && i.Image.Length > 0)
                {

                    //string image = Convert.ToBase64String(i.GetResizedImage(350,350));
                    string image = Convert.ToBase64String(i.Image);
                    //imageFull = string.Format("data:image/" + "png" + ";base64,{0}", Convert.ToBase64String(i.GetFullImage()));
                    //string src = string.Format("data:image/" + i.Extension + ";base64,{0}", image);
                    src = string.Format("data:image/" + "png" + ";base64,{0}", image);
                    if(src != null)
                    { hasImage = "block"; }
                }
                else
                {
                    src = "images/ImageComingSoon300x.png";
                    hasImage = "block";
                }
                // if(i.Status == 1)
                // {
                //     colorCode = "#c43535";
                // }
                // if(i.Status == 2)
                // {
                //     colorCode = "#ffcc00";
                // }
                // if(i.Status == 3)
                // {
                //     colorCode = "#77b300";
                // }
                sb.Append($"<div class='col-md-4 card border-primary mb-3 m-4 pb-1' style='max-width: 25rem;'><div class='card-header bg-primary'><b style=color:white;>{i.Name}</b></div><div class='card-body'><h4 class='card-title'></h4><p class='card-text'>{i.Description}</p><p class='float-md-center' style='text-align:center;'><center><img src='{src}'  style='display:{hasImage}; text-align:center; border-radius:5%; cursor:pointer;'  onclick=ShowFullImage(\"{i.ID}\",'{i.Name.Replace(' ', '-')}'); /></center></p></div><div><label class='text-success'>${i.Cost.ToString()}/OBO</label></div><div>Last Updated:{i.Updated.ToShortDateString()}</div><div><input type='button' class='btn btn-success' style='width:100%; display:none;' name='Reserve' value='Reserve This' /></div></div>");
                src = string.Empty;
                hasImage = "none";
                @Html.Raw(sb.ToString());
                sb.Clear();
                cardCount++;
                itemCount++;
                if (cardCount == 3)
                {
                    sb.Append("</div>");
                    @Html.Raw(sb.ToString());
                    sb.Clear();
                    cardCount = 0;
                    //Check to see if we need another row or now.
                    if (itemCount < Model.Items.Count)
                    {
                        sb.Append("<div class='row'>");
                    }
                }
        }
    }
}
</div>
<div class="modal-FullImage fade" role="dialog" id="mdlFullImage" tabindex="-1" aria-hidden="true" aria-labelledby="mdlAddItem" style="width:100%;">
    <div class="modal-dialog modal-md" style="color:black; border-color:orange;">
        <div class="modal-content pl-3 pr-3" style="height:100%; border:0px;">
            <div class="modal-header">
                <h5 class="modal-title">@Model.Name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"></span>
                </button>
            </div>
            <div class="modal-body">
                <img src="@Model.Image" id="imgFullImage" style="border-radius:5%;"/>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
}

