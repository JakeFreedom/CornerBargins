<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alkota Parts Ordering</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    

    
    @Html.AntiForgeryToken()
</head>
<body class="bg-primary-subtle">
    <header>
        <div class="row" style="border:solid 0px green;">
            <div class="col-md-1">
                <img src='~/images/cb-logo-5.png' style="width:585%;" />
            </div>
            <div class="col-md-10" style="vertical-align:bottom; border:solid 0px red;">
                <center>
    
                </center>
            </div>
        </div>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-primary border-bottom box-shadow mb-3" style="display:block;">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index" style="color:white; display:none;">Current Listing</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/ShoppingCart/Index">Cart(<label id="lblCartQty"></label>)</a>
                        </li> *@
                    </ul>
                </div>
                <div><a class="nav-link text-dark" style="display:none;" asp-area="" asp-page="/Logout">Logout</a></div>
            </div>
        </nav>
    </header>
    <div class="container" style="border:solid 0px green;">
        <main role="main" class="pb-3" style="border:solid 0px red; text-align:center;">
            @RenderBody()
        </main>
    </div>
    <div class="col-md-12" style="height:100px;"></div>
    <footer class="footer" style="border:solid 1px black;">
        <div class="container">
            &copy; @DateTime.Now.Year.ToString() - Corner Bargins - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>



        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/handleLogin.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>