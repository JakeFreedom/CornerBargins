@page
@model CB.Pages.Tools.Manage.IndexModel
@{
    Layout = "_Layout";
}

<div class="container">
    <div class="row">
        <div class="col-md-3 m-2 p-2" style="border:0px solid green; text-align:left;">
            <button id="btnAddItem" class="btn btn-primary">Add New Item</button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            @*Table of items starts here*@
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Cost</th>
                        <th scope="col">Status</th>
                        <th scope="col">Link</th>
                        <th scope="col">Last Updated</th>
                    </tr>
                </thead>
                @*Loop this to generate table*@
                <tbody>
                    @{
                        string tableRowColorP="table-primary";
                        string tableRowColorS = "table-success";
                        string finalTableRowColor = tableRowColorP;
                        string dataBsTarget = "#tableRowDiv";
                        int divIndex = 1;
                        string divIndexName = "tableRowDiv";
                        string imageSource = string.Empty;
                        string src = string.Empty;
                    }
                        <div class="accordion" id="accordionExample">
                        @foreach (Core.Item item in Model.Items)
                        {
                            
                            imageSource =  Convert.ToBase64String(item.GetResizedImage(300, 300));
                            src = string.Format("data:image/" + "png" + ";base64,{0}", imageSource);
                            dataBsTarget = $"#tableRowDiv{divIndex.ToString()}";
                            divIndexName = $"tableRowDiv{divIndex.ToString()}";

                                @if (finalTableRowColor == tableRowColorP)
                                    finalTableRowColor = tableRowColorS;
                                else
                                    finalTableRowColor = tableRowColorP;

                                <tr class="@finalTableRowColor"  aria-expanded="true"  style="cursor:pointer;" onclick="ShowDiv(`@dataBsTarget`)">
                                @*Switch between Primary and Success*@
                                        <th scope="row">@item.ID</th>
                                        <td>@item.Name</td>
                                        <td>@Decimal.Parse(item.Cost.ToString()).ToString("C")</td>
                                        <td>@item.Status</td>
                                        <td>@item.Link</td>
                                        <td>@item.Updated.ToShortDateString()</td>
                                </tr>
                                <tr class="collapse accordion-collapse" data-bs-parent="#accordionExample" id="@divIndexName">
                                    <td colspan="6">
                                        <div class="accordion-collapse " aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                            <div class="accordion-body">
                                                @*This is where we will be able to edit the item*@
                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <img src="@src" id="itemImage-@item.ID" />
                                                        <div class="row">
                                                            <div class="col-md-2"></div>
                                                            <div id="dropFilesArea" class="col-md-8 border-black" style="border:1px solid black;" ondragover="FileDropAreaEntered(event)" ondrop="UploadDroppedFiles(event, @item.ID);" draggable="true">
                                                                <p>drop files here</p>
                                                            </div>
                                                            <div class="col-md-2"></div>
                                                        </div>
                                                        <div class="row">

                                                            <div class="col-md-3"></div>
                                                            <div class="col-md-3 form-check">
                                                                <input class="form-check-input" type="checkbox" value="" id="chkItemVisible-@item.ID">
                                                                <label class="form-check-label" for="chkItemVisible">
                                                                    Visible
                                                                </label>
                                                            </div>
                                                            <div class="col-md-4 form-check">
                                                                <input class="form-check-input" type="checkbox" value="" id="chkShowResButton-@item.ID">
                                                                <label class="form-check-label" for="chkShowResButton">
                                                                    Show Button
                                                                </label>
                                                            </div>
                                                            <div class="col-md-1"></div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <div class="row">
                                                            <div class="col-md-4" style="text-align:right;"><label>Title:</label></div>
                                                            <div class="col-md-8"><input type="text" class="form-control" value="@item.Name" /></div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-4" style="text-align:right;"><label>Description:</label></div>
                                                            <div class="col-md-8" style="border:0px solid green;"><textarea class="form-control" cols="40" rows="5">@item.Description</textarea></div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-4" style="text-align:right;"><label>Cost:</label></div>
                                                            <div class="col-md-8" style="border:0px solid green;"><input class="form-control" type="text" value="@item.Cost" /></div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-4" style="text-align:right;"><label>Link:</label></div>
                                                            <div class="col-md-8" style="border:0px solid green;"><input class="form-control" type="text" value="@item.Link" /></div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-4" style="text-align:right;"><label>Status:</label></div>
                                                            <div class="col-md-8" style="border:0px solid green;">
                                                            <select class="form-select" id="selItemStatus">
                                                                <option value="-1">Select Status</option>
                                                                <option value="0">Unknown</option>
                                                                <option value="1">Listed</option>
                                                                <option value="2">Pending</option>
                                                                <option value="3">Sold</option>
                                                            </select>
                                               

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-10"></div>
                                            <div class="col-md-2"><button class="btn btn-warning" onclick="UpdateItem(@divIndex)">Update</button></div>
                                        </div>
                                    </td>
                                </tr>
                  
                            divIndex++;
                        }
                </div>
                </tbody>
            </table>
        </div>
    </div>
</div>

@*Add New Item Modal*@
<div class="modal-additem fade" role="dialog" id="mdlAddItem" tabindex="-1" aria-hidden="true" aria-labelledby="mdlAddItem" style="width:100%;">
    <div class="modal-dialog modal-md" style="color:black; border-color:orange;">
        <div class="modal-content pl-3 pr-3" style="height:100%; border:0px;">
            <div class="modal-header">
                <h5 class="modal-title">Add New Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"></span>
                </button>
            </div>
            <div class="modal-body">
                <form enctype="multipart/form-data" method="post" id="frmImageUpload">
                    <input type="file" id="userFile" name="userFile" />
                    <input type="button" value="Save" onclick="UploadImage()" />
                </form>

                <div class="row pt-2 mt-2" style="border:solid 1px green;">
                    <div class="col-md-6">
                        <div>
                            <label class="col-form-label mt-2" for="txtItemName">Item Name</label>
                            <input type="text" class="form-control" placeholder="" id="txtItemName" required>
                        </div>
                        <div>
                            <label class="col-form-label mt-2" for="txtItemCost">Item Cost</label>
                            <input type="text" class="form-control" placeholder="" id="txtItemCost">
                        </div>
                        <div>
                            <label class="col-form-label mt-2" for="txtLabelColor">Label Color</label>
                            <input type="text" class="form-control" placeholder="" id="txtLabelColor">
                        </div>
                        <div>
                            <label class="col-form-label mt-2" for="txtItemLink">Item Link</label>
                            <input type="text" class="form-control" placeholder="" id="txtItemLink">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div>
                            <label for="txtItemDescription" class="form-label mt-2">Item Description</label>
                            <textarea class="form-control" id="txtItemDescription" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            @* <div>
                    <input type="button" class="btn btn-primary" style="opacity:.2;" value="AddItem" id="btnAddItem" disabled />
                    <input type="button" class="btn btn-warning float-right mr-2 btn" value="Cancel" data-target="#mdlAddItem" data-toggle="modal" />
                </div> *@
            <br />
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ToolActions.js" asp-append-version="true"></script>
}

