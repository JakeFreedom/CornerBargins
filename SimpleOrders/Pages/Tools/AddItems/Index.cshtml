@page
@model CB.Pages.Tools.AddItems.IndexModel


@{
    
}

@Html.AntiForgeryToken()
<div class="container">
    <h1>Welcome to the tools</h1>

    <input type="button" value="Add Item" onclick="ShowAddItemModal()" />

    @*Add Item Modal*@
    <div class="modal-additem fade" role="dialog" id="mdlAddItem" tabindex="-1" aria-hidden="true" aria-labelledby="mdlAddItem" style="width:100%;">
        <div class="modal-dialog modal-md" style="color:black; border-color:orange;">
            <div class="modal-content pl-3 pr-3" style="height:100%; border:0px;">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"  aria-label="Close">
                        <span aria-hidden="true"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <form enctype="multipart/form-data" method="post" id="frmImageUpload">
                        <input type="file" id="userFile" name="userFile" />
                        <input type="button" value="Save" onclick="UploadImage()" />
                    </form>

                    <div class="row pt-2 mt-2" style="border:solid 1px green;">
                        <div class="col-md-6">
                            <div>
                                <label class="col-form-label mt-2" for="txtItemName">Item Name</label>
                                <input type="text" class="form-control" placeholder="" id="txtItemName" required>
                            </div>
                            <div>
                                <label class="col-form-label mt-2" for="txtItemCost">Item Cost</label>
                                <input type="text" class="form-control" placeholder="" id="txtItemCost">
                            </div>
                            <div>
                                <label class="col-form-label mt-2" for="txtLabelColor">Label Color</label>
                                <input type="text" class="form-control" placeholder="" id="txtLabelColor">
                            </div>
                            <div>
                                <label class="col-form-label mt-2" for="txtItemLink">Item Link</label>
                                <input type="text" class="form-control" placeholder="" id="txtItemLink">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <label for="txtItemDescription" class="form-label mt-2">Item Description</label>
                                <textarea class="form-control" id="txtItemDescription" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                @* <div>
                    <input type="button" class="btn btn-primary" style="opacity:.2;" value="AddItem" id="btnAddItem" disabled />
                    <input type="button" class="btn btn-warning float-right mr-2 btn" value="Cancel" data-target="#mdlAddItem" data-toggle="modal" />
                </div> *@
                <br />
            </div>
        </div>
    </div>


    @*<img src="@Model.Image" id="uploadedImage" />*@

</div>



@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ToolActions.js" asp-append-version="true"></script>
}

